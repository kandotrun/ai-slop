{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giga-site-bin-local",
  "workers_dev": true,
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_HOST": "giga-site.com",
    "APP_BASE_PATH": "/app",
    "PREVIEW_HOST_SUFFIX": ".giga-site.com",
    "EMAIL_FROM": "no-reply@giga-site.com",
    "CONTACT_TO": "support@example.com",
    "OLLAMA_API_BASE_URL": "https://ollama.com/api",
    "OLLAMA_SECURITY_MODEL": "deepseek-v4-pro:cloud",
    "PAID_CHECKOUT_ENABLED": "false",
    "GA_MEASUREMENT_ID": "",
    "MAX_HTML_BYTES": "10485760",
    "MAX_UPLOAD_FILES": "200",
    "SESSION_TTL_SECONDS": "86400"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["no-reply@giga-site.com"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "HTML_BUCKET",
      "bucket_name": "replace-with-r2-bucket-name"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-d1-database-name",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ]
}
